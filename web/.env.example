# From Supabase: Project Settings > API. The anon key is safe in the browser;
# row level security limits it to the emails in team_members.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Set to 1 to preview the dashboard with sample data and no login.
VITE_DEMO=0
